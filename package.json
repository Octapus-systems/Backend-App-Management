{
  "name": "encore-backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Encore Executive API — bookings, quotations, dispatch, payments, notifications",
  "main": "index.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env --env-file-if-exists=../.env index.js",
    "dev": "node --env-file-if-exists=.env --env-file-if-exists=../.env --watch index.js",
    "seed": "node seed.js --reset",
    "test": "node --test tests/*.test.js"
  },
  "engines": { "node": ">=22.13" },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2"
  }
}
